Screen {
    background: black;
}

#app-grid {
    layout: grid;
    grid-size: 3 5;
    grid-gutter: 1;
    padding: 1;
}

#warning-bar {
    height: 3;
    background: $error;
    color: white;
    text-style: bold;
    content-align: center middle;
    border: heavy red;
}

.panel, RadarWidget, DigitalSkull, MatrixRain, ThreatPanel, GeoLocationTracker,
SatelliteSyncPanel, SignalStrengthGraph, BiometricScanner, DarknetRelayMonitor,
EncryptedTunnelStatus, AIConfidenceScore, ThreatProbabilityChart,
OperationTimer, TacticalHUD, ClassifiedDocumentViewer, CyberSkullAnimation {
    border: solid cyan;
    margin: 1;
    padding: 1;
    background: #0a0a0a;
    height: 12;
}

MatrixRain {
    layer: background;
    opacity: 0.3;
    height: 100%;
    width: 100%;
}
